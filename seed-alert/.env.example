# Copy this file to .env and fill it in. Never share .env with anyone.

# From https://my.telegram.org -> API development tools (free)
TG_API_ID=
TG_API_HASH=

# Channel to watch (username or t.me link)
CHANNEL=SecretSocietyOfNinjas

# Optional but recommended: a bot token from @BotFather so alerts ring your phone.
# Open your bot in Telegram and press Start once, or it can't message you.
BOT_TOKEN=

# 1 = also alert on every new post (useful if seeds get posted as images)
ALERT_ALL_POSTS=1
